# ACR Tasks-compatible Dockerfile for the chainfill fork.
#
# Differs from upstream Dockerfile by:
#   - Drops BuildKit-only directives (--platform=$BUILDPLATFORM, --mount=type=cache)
#     because ACR Tasks classic uses Moby builder, not BuildKit.
#   - Hard-codes linux/amd64 (our target arch on Azure Container Apps).
#   - Builds the whole ./cmd package instead of cmd/main.go (multi-file pkg).
#   - Adds a Node stage to build dev-server-ui (Next.js → Vite) into the
#     static assets that pkg/devserver/ui.go expects via //go:embed all:static.
#     Mirrors what upstream's `make build-ui` produces in the goreleaser pipeline.
#   - Wraps the binary in Datadog serverless-init for in-container log + metric
#     forwarding to Datadog (Path A — no source-level tracer changes).
#     Final stage is debian:bookworm-slim (NOT alpine) because serverless-init
#     is dynamically linked against glibc and won't exec on musl.
#
# Build with:
#   az acr build --registry chainfillcrshared \
#     --image inngest:vX.Y.Z-chainfill.N --platform linux/amd64 \
#     --file Dockerfile.acr .

FROM node:20-alpine AS ui-build
RUN corepack enable && corepack prepare pnpm@10.18.2 --activate
WORKDIR /app
COPY ui ui
# graphql-codegen schema source — referenced from ui/apps/dev-server-ui/codegen.ts
COPY pkg/coreapi pkg/coreapi
RUN cd ui && pnpm install --frozen-lockfile
RUN cd ui/apps/dev-server-ui && pnpm build

FROM golang:1.25.9-alpine AS build
RUN apk add build-base
WORKDIR /app
COPY vendor vendor
COPY . .
# Drop the built UI dist into the static dir that pkg/devserver/ui.go embeds
COPY --from=ui-build /app/ui/apps/dev-server-ui/dist/ pkg/devserver/static/
# Static linkage so the binary runs on glibc-based final stage (matches upstream
# release Dockerfile.goreleaser which also uses a non-alpine debian base).
RUN GOFLAGS=-mod=vendor CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -ldflags="-s -w" -o /go/bin/inngest ./cmd

# Final stage on Debian to be compatible with the glibc-based datadog-init binary
FROM debian:bookworm-slim AS inngest
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates tzdata \
 && rm -rf /var/lib/apt/lists/* \
 && update-ca-certificates
COPY --from=datadog/serverless-init:1 /datadog-init /app/datadog-init
COPY --from=build /go/bin/inngest /bin/inngest
ENTRYPOINT ["/app/datadog-init"]
# CMD intentionally omitted: container app supplies command:[/app/datadog-init]
# args:[inngest, start]. ACA's command override REPLACES Docker ENTRYPOINT
# (not concatenates), so the container app must invoke the wrapper explicitly.
